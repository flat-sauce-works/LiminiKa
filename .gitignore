*.cubin
*.fatbin
*.spv
*.air
*.metallib
*.bc
.nv/
.metal-cache/
.vk-cache/
.hip-cache/

# CMake Generated Files
CMakeCache.txt
CMakeFiles/
CMakeAutoGen/
