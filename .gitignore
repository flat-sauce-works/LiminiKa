# name: .gitignore
# SPDX-License-Identifier: MIT OR Apache-2.0

# =============================================================================
# LiminiKa - Git Ignore Rules
# =============================================================================

# -----------------------------------------------------------------------------
# AI Coding Agents, Google Antigravity & Local Skill Workspaces
# -----------------------------------------------------------------------------
.agent/
.agents/
.antigravity/
.gemini/
.idx/
*.antigravity*
.cursor/
.windsurf/
.clinerules
.continuerules
SESSION_STATE.md

# -----------------------------------------------------------------------------
# VSCodeCounter Output
# -----------------------------------------------------------------------------
.VSCodeCounter/
.VSCodeCounter*/

# -----------------------------------------------------------------------------
# Rust Build Artifacts & Cargo
# -----------------------------------------------------------------------------
/target/
**/*.rs.bk

# Profiling, coverage, and benchmark outputs
*.profraw
*.profdata
*.lprof
/coverage/
*.gcov
cargo-timing*.html

# -----------------------------------------------------------------------------
# C / C++ / CUDA / GPU Kernel Build Artifacts
# -----------------------------------------------------------------------------
/build/
/build*/
/cmake-build-*/
/bin/
/lib/

# Object files and libraries
*.o
*.obj
*.so
*.dylib
*.dll
*.a
*.lib
*.exp
*.exe

# GPU Compiled Shaders & Kernels (CUDA / Metal / Vulkan)
*.ptx
*.cubin
*.fatbin
*.spv
*.air
*.metallib
*.bc
.nv/
.metal-cache/
.vk-cache/
.hip-cache/

# CMake & Ninja artifacts
CMakeCache.txt
CMakeFiles/
CMakeAutoGen/
cmake_install.cmake
CTestTestfile.cmake
Testing/
.ninja_deps
.ninja_log
build.ninja
.ccache/
compile_commands.json

# -----------------------------------------------------------------------------
# Python Tooling, Scripts & Virtual Environments
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
/dist/
/sdist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
ENV/
env/

# -----------------------------------------------------------------------------
# LLM Model Weights, Checkpoints & Large Datasets
# -----------------------------------------------------------------------------
*.bin
*.safetensors
*.gguf
*.ggml
*.pt
*.pth
*.onnx
*.ot
*.tflite

# Keep directory structures via .gitkeep, ignore actual model/adapter contents
models/*
!models/.gitkeep
weights/*
!weights/.gitkeep
adapters/*
!adapters/.gitkeep
datasets/*
!datasets/.gitkeep

# -----------------------------------------------------------------------------
# LiminiKa Runtime State & Binary Containers
# -----------------------------------------------------------------------------
*.gcso
*.gcsopack
*.gcsocore
*.sta

containers/*
!containers/.gitkeep
deployments/*
!deployments/.gitkeep
snapshots/*
!snapshots/.gitkeep

# -----------------------------------------------------------------------------
# Environment Variables, Secrets & Local Configs
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# -----------------------------------------------------------------------------
# Logs & Temporary Files
# -----------------------------------------------------------------------------
*.log
/logs/
/tmp/
/temp/

# -----------------------------------------------------------------------------
# OS & Editor / IDE Specific Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs & Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.clangd/
.cache/
.zed/
.helix/
.fleet/
*.swp
*.swo
*~