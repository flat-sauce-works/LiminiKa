.VSCodeCounter/
.VSCodeCounter*/

# -------------------------------------------------------------------
# Rust Build Artifacts, Cargo, Coverage & Benchmarks
# -------------------------------------------------------------------
/target/
**/*.rs.bk
*.profraw
*.profdata
*.lprof
/coverage/
*.gcov
cargo-timing*.html

# -------------------------------------------------------------------
# C / C++ / CUDA / GPU Build Artifacts, CMake & Toolchains
# -------------------------------------------------------------------
/build/
/build*/
/cmake-build-*/
/bin/
/lib/
*.o
*.obj
*.so
*.dylib
*.dll
*.a
*.lib
*.exp
*.exe

# GPU Compute Artifacts & Compiler Caches (CUDA / Vulkan / Metal / ROCm)
