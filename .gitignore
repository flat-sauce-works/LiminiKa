CTestTestfile.cmake
Testing/

# Ninja Build Files
.ninja_deps
.ninja_log
build.ninja

# Build Caches & Tooling
.ccache/
compile_commands.json

# -------------------------------------------------------------------
# Python Tooling, Test Fixtures & Virtual Environments
# -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
/dist/
/sdist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
ENV/
env/

