# name: .editorconfig
# SPDX-License-Identifier: MIT OR Apache-2.0
# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust, C/C++, CUDA, and Metal source files
[*.{rs,c,h,cpp,hpp,cc,cxx,cu,cuh,metal,mm}]
indent_size = 4
max_line_length = 100

# Python scripts
[*.py]
indent_size = 4
max_line_length = 120

# CMake build scripts
[{CMakeLists.txt,*.cmake}]
indent_size = 4

# Use 2-space indentation for configuration and metadata files
[*.{yml,yaml,toml,json}]
indent_size = 2

# Markdown documentation (preserve trailing two-space line breaks)
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# LiminiKa DSL Source Files
[*.lmnk]
indent_size = 4

# Force tab indentation for Makefiles
[{Makefile,*.mk}]
indent_style = tab

# Windows Batch scripts require CRLF line endings
[*.{bat,cmd}]
end_of_line = crlf
